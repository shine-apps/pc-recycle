# 本地无 Docker：使用 PGlite（进程内 Postgres，Drizzle 原生支持）
DATABASE_URL=pglite://./.data/pglite

# 生产（用户本机 Docker，见 docker-compose.yml）：
# DATABASE_URL=postgres://pc:pcpass@localhost:5432/pcrecycle

# 管理员（首次 seed 写入库）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话签名密钥（生产请替换为随机长字符串）
AUTH_SECRET=replace-with-random-secret

# 站点对外访问地址（生产填 https 正式域名，用于微信分享卡片 og:image 等绝对 URL）
# 注意：NEXT_PUBLIC_ 变量在构建时内联，Docker 部署需通过 compose 的 build.args 传入
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
